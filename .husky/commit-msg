#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Commit message format validation
commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Pattern: type(scope): description
# Examples:
#   feat(discovery): add levenshtein algorithm
#   fix(neo4j): prevent connection leak
#   test(schema): add integration tests
#   docs: update testing guide

pattern="^(feat|fix|test|refactor|docs|style|perf|chore)(\(.+\))?: .{10,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo "❌ Invalid commit message format!"
  echo ""
  echo "Expected format:"
  echo "  type(scope): brief description (at least 10 chars)"
  echo ""
  echo "Valid types: feat, fix, test, refactor, docs, style, perf, chore"
  echo ""
  echo "Examples:"
  echo "  feat(discovery): add levenshtein distance algorithm"
  echo "  fix(neo4j): prevent connection leak in repository"
  echo "  test(schema): add integration tests for SQLite extraction"
  echo "  docs: update testing strategy documentation"
  echo ""
  exit 1
fi

echo "✅ Commit message format valid"
